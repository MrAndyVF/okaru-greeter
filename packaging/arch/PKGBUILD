# Paquete local de OKARU Greeter: compila la rama main de ~/Projects/okaru-project/okaru-greeter (solo lo que está en commits).
pkgname=okaru-greeter
pkgver=1.0.0
pkgrel=1
pkgdesc='OKARU Greeter: pantalla de inicio de sesión para greetd'
arch=(x86_64)
url='https://github.com/MrAndyVF/okaru-greeter'
license=(MIT)
depends=(bash cairo dbus fontconfig freetype2 gcc-libs glib2 glibc greetd libglvnd libinput libjxl librsvg libwebp
         libxkbcommon libxml2 noto-fonts pango tomlplusplus ttf-bigblueterminal-nerd wayland wlroots0.20)
# Sin paquete -debug: nadie lo instala y solo infla el repositorio.
options=('!debug')
makedepends=(git meson ninja pkgconf wayland-protocols stb nlohmann-json)
optdepends=('okaru: sincroniza fondo, colores y monitores desde la shell (paquete propio)'
            'accountsservice: fotos de usuario y cuentas en red (sin él lista /etc/passwd)')
source=("okaru-greeter::git+file://${OKARU_GREETER_REPO:-$HOME/Projects/okaru-project/okaru-greeter}#branch=main")
sha256sums=(SKIP)

pkgver() {
  cd okaru-greeter
  git describe --long --tags --abbrev=9 | sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/'
}

build() {
  arch-meson okaru-greeter build
  meson compile -C build
}

# Ata el paquete a las bibliotecas del sistema con las que se compiló: si una actualización les cambia el soname
# (libjxl 0.12 → 0.13 dejó el greeter sin arrancar), pacman se niega a hacerla hasta que se publique OKARU
# recompilado, en vez de romper el sistema. Las que declaran su soname en provides (libxml2.so=16-64) las fija
# makepkg; las que no (libqalculate, libical, md4c) se fijan a la versión mayor.menor de su paquete. glibc no cambia
# de soname y no se fija.
_fijar_bibliotecas() {
  local so dueno ver
  while read -r so; do
    if pacman -T "${so%%.so*}.so" >/dev/null; then
      depends+=("${so%%.so*}.so")
    elif dueno=$(pacman -Qqo "/usr/lib/$so" 2>/dev/null) && [[ $dueno != glibc ]]; then
      ver=$(pacman -Q "$dueno" | cut -d' ' -f2)
      ver=${ver#*:}
      ver=${ver%-*}
      if [[ $ver =~ ^([0-9]+)\.([0-9]+) ]]; then
        depends+=("$dueno>=${BASH_REMATCH[0]}" "$dueno<${BASH_REMATCH[1]}.$((BASH_REMATCH[2] + 1))")
      else
        depends+=("$dueno=$ver")
      fi
    fi
  done < <(find "$pkgdir" -type f -perm -u+x -exec readelf -d {} + 2>/dev/null \
    | sed -nr 's/.*Shared library: \[(.*)\].*/\1/p' | sort -u)
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 okaru-greeter/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  _fijar_bibliotecas
}
